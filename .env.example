# Supabase (same project as the mobile app)
# Used for coming-soon message via get_public_feature_gates()
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for account deletion + support form inserts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Store badges on home + /download (early joiners)
NEXT_PUBLIC_IOS_STORE_URL=
NEXT_PUBLIC_ANDROID_STORE_URL=
